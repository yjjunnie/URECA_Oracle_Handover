#!/bin/bash
# ============================================================
# Template: CPU-only analysis job
#
# Use a SEPARATE, lighter env from your GPU inference env. CPU nodes
# queue almost immediately, so analysis iterations are fast instead of
# waiting behind a GPU allocation. Note: no ngpus in the select line.
#
# Submit: qsub cpu_analysis.pbs
# ============================================================

#PBS -N my_analysis
#PBS -l select=1:ncpus=2:mem=16gb
#PBS -l walltime=00:30:00
#PBS -o /scratch/users/ntu/CHANGEME/logs/analyze.out
#PBS -e /scratch/users/ntu/CHANGEME/logs/analyze.err

USER_ID="CHANGEME"
SCRATCH="/scratch/users/ntu/$USER_ID"
ENV_PATH="$SCRATCH/envs/analysis"     # CPU-only; no torch, no CUDA
RESULTS="$SCRATCH/analysis_results"

mkdir -p "$SCRATCH/logs" "$RESULTS"
cd "$SCRATCH" || exit 1

module purge
module load python/3.11.7-gcc11

export PIP_CACHE_DIR="$SCRATCH/pip_cache"
mkdir -p "$PIP_CACHE_DIR"

# Build the env on first run only.
if [ ! -d "$ENV_PATH" ]; then
    echo "Creating analysis venv at $ENV_PATH ..."
    python3 -m venv "$ENV_PATH"
fi
source "$ENV_PATH/bin/activate"
pip install --quiet pandas numpy scipy seaborn matplotlib

echo "Start: $(date)"

# Analysis scripts should make no cluster assumptions, so they can also
# be run locally on downloaded results.
python "$SCRATCH/my_analysis.py"

STATUS=$?
echo "Exit status: $STATUS"
echo "Done: $(date)"
exit $STATUS
