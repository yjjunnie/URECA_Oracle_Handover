#!/bin/bash
#PBS -N boltz_analyze
#PBS -l select=1:ncpus=2:mem=16gb
#PBS -l walltime=00:30:00
#PBS -o /scratch/users/ntu/<YOUR_NSCC_ID>/logs/analyze.out
#PBS -e /scratch/users/ntu/<YOUR_NSCC_ID>/logs/analyze.err

SCRATCH="/scratch/users/ntu/<YOUR_NSCC_ID>"
ENV_PATH="$SCRATCH/envs/analysis"   # CPU-only venv, separate from the GPU boltz venv

mkdir -p "$SCRATCH/logs" "$SCRATCH/boltz_analysis_results_fullprot"
cd "$SCRATCH" || exit 1

module load python/3.11.7-gcc11
source "$ENV_PATH/bin/activate"

export PIP_CACHE_DIR="$SCRATCH/pip_cache"
mkdir -p "$PIP_CACHE_DIR"
"$ENV_PATH/bin/pip" install --quiet pandas numpy scipy seaborn matplotlib

echo "Start: $(date)"
"$ENV_PATH/bin/python" "$SCRATCH/04_analyze.py"
STATUS=$?
echo "Exit status: $STATUS"
echo "Done:  $(date)"
exit $STATUS
