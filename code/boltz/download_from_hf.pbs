#!/bin/bash
#PBS -N download_hf
#PBS -l select=1:ncpus=2:mem=8gb
#PBS -l walltime=00:15:00
#PBS -o /scratch/users/ntu/hzhang08/logs/download_hf.out
#PBS -e /scratch/users/ntu/hzhang08/logs/download_hf.err

SCRATCH="/scratch/users/ntu/hzhang08"
ENV_PATH="$SCRATCH/envs/analysis"   # CPU-only venv, separate from the GPU boltz venv

mkdir -p "$SCRATCH/logs" "$SCRATCH/data"
cd "$SCRATCH" || exit 1   # avoid cwd shadowing (python puts cwd first on sys.path)

module load python/3.11.7-gcc11
source "$ENV_PATH/bin/activate"

export HF_TOKEN=os.environ["HF_TOKEN"]  # was hardcoded; read from env instead
export HUGGING_FACE_HUB_TOKEN="$HF_TOKEN"

# Keep HF's cache (incl. the Xet staging dir) AND pip's cache off the small home quota
export HF_HOME="$SCRATCH/hf_cache"
export HF_HUB_DISABLE_XET=1
export PIP_CACHE_DIR="$SCRATCH/pip_cache"
mkdir -p "$HF_HOME" "$PIP_CACHE_DIR"

echo "Python: $("$ENV_PATH/bin/python" --version)"
"$ENV_PATH/bin/pip" install --quiet huggingface_hub
PIP_STATUS=$?
echo "pip install exit status: $PIP_STATUS"
"$ENV_PATH/bin/python" -c "import huggingface_hub; print('huggingface_hub OK ->', huggingface_hub.__file__)"
if [ $? -ne 0 ]; then
    echo "ERROR: huggingface_hub still broken — check for a shadowing file/dir on sys.path"
    exit 1
fi

"$ENV_PATH/bin/python" - << 'PYEOF'
import os
from huggingface_hub import hf_hub_download

HF_TOKEN = os.environ["HF_TOKEN"]
HF_REPO  = "yjjunnie/ureca-boltz-data"
SCRATCH  = "/scratch/users/ntu/hzhang08"

REPO_FILES = [
    ("data/flow-cytometry.bz2",    f"{SCRATCH}/data/flow-cytometry.bz2"),
    ("data/hap-titration.bz2",     f"{SCRATCH}/data/hap-titration.bz2"),
    ("data/konermann_seqs.xlsx",   f"{SCRATCH}/data/konermann_seqs.xlsx"),
    ("data/konermann_kd.xlsx",     f"{SCRATCH}/data/konermann_kd.xlsx"),
    ("data/azimuth_V1.xlsx",       f"{SCRATCH}/data/azimuth_V1.xlsx"),
    ("scripts/generate_yamls.py",  f"{SCRATCH}/generate_yamls.py"),
    ("scripts/generate_yamls.pbs", f"{SCRATCH}/generate_yamls.pbs"),
    ("scripts/03_boltz_batch.pbs",       f"{SCRATCH}/03_boltz_batch.pbs"),
    ("scripts/04_analyze.py",            f"{SCRATCH}/04_analyze.py"),
    ("scripts/04b_analyze_balanced.py",  f"{SCRATCH}/04b_analyze_balanced.py"),
    ("scripts/05_analyze.pbs",           f"{SCRATCH}/05_analyze.pbs"),
    ("scripts/05b_analyze_balanced.pbs", f"{SCRATCH}/05b_analyze_balanced.pbs"),
]

for repo_path, dest_path in REPO_FILES:
    os.makedirs(os.path.dirname(dest_path), exist_ok=True)
    print(f"Downloading {repo_path} ...", flush=True)
    local = hf_hub_download(
        repo_id=HF_REPO,
        filename=repo_path,
        repo_type="dataset",
        token=HF_TOKEN,
        local_dir=os.path.dirname(dest_path),
        local_dir_use_symlinks=False,
    )
    if os.path.abspath(local) != os.path.abspath(dest_path):
        os.replace(local, dest_path)
    print(f"  -> {dest_path}", flush=True)

print("\nAll files downloaded.")
print("Next: python /scratch/users/ntu/hzhang08/generate_yamls.py")
PYEOF
STATUS=$?

echo "Exit status: $STATUS"
exit $STATUS
