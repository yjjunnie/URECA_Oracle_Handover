#!/bin/bash
#PBS -N boltz_test
#PBS -l select=1:ncpus=8:mem=64gb:ngpus=1
#PBS -l walltime=00:30:00
#PBS -o /scratch/users/ntu/<YOUR_NSCC_ID>/logs/boltz_test.out
#PBS -e /scratch/users/ntu/<YOUR_NSCC_ID>/logs/boltz_test.err

# ============================================================
# Test Boltz on a real GPU node using a minimal Cas13 complex.
#
# Run AFTER 00_install_boltz.pbs completes.
#
# What this checks:
#   1. torch sees the A100 GPU
#   2. CUDA version is compatible
#   3. Boltz inference runs end-to-end
#   4. Prints confidence JSON key names: needed before writing parser
#
# Submit with: qsub 01_test_boltz.pbs
# Check logs:  cat /scratch/users/ntu/<YOUR_NSCC_ID>/logs/boltz_test.out
# ============================================================

SCRATCH="/scratch/users/ntu/<YOUR_NSCC_ID>"
ENV_PATH="$SCRATCH/envs/boltz"
BOLTZ_CACHE="$SCRATCH/boltz_cache"
TEST_OUT="$SCRATCH/boltz_test_out"

mkdir -p "$SCRATCH/logs"
mkdir -p "$TEST_OUT"

echo "=== Boltz GPU Test ==="
echo "Start: $(date)"
echo "Node:  $(hostname)"
echo ""

# ── GPU diagnostics ───────────────────────────────────────────
echo "=== GPU info ==="
nvidia-smi 2>/dev/null || echo "WARNING: nvidia-smi not found"

# ── Activate env ──────────────────────────────────────────────
module load python/3.11.7-gcc11
module load cuda/12.8.1
source "$ENV_PATH/bin/activate"

# Redirect triton and tmp caches to scratch to avoid /var/tmp quota limits
export TMPDIR="$SCRATCH/tmp"
export TRITON_CACHE_DIR="$SCRATCH/triton_cache"
mkdir -p "$TMPDIR" "$TRITON_CACHE_DIR"

echo ""
echo "=== PyTorch GPU check ==="
python - << 'PYCHECK'
import torch
print(f"torch version:        {torch.__version__}")
print(f"CUDA available:       {torch.cuda.is_available()}")
if torch.cuda.is_available():
    print(f"CUDA version (torch):  {torch.version.cuda}")
    print(f"GPU name:             {torch.cuda.get_device_name(0)}")
else:
    print("WARNING: torch cannot see GPU, need to reinstall torch with correct CUDA build")
    print("         Run 02_fix_torch_cuda.pbs with the CUDA version from nvidia-smi above")
PYCHECK

# ── Write test YAML ───────────────────────────────────────────
# Minimal CasRx complex: protein stub + 30nt DR + 23nt spacer + 23nt target.
# The protein is truncated: real jobs will use the full 967 aa sequence.
TEST_YAML="$SCRATCH/test_casrx.yaml"
cat > "$TEST_YAML" << 'YAML'
version: 1
sequences:
  - protein:
      id: A
      sequence: "MASTKVNLPYLQNLKEQRFIEELLKQHQG"
  - rna:
      id: B
      sequence: "AACCCCUACCAACUGGUCGGGGUUUGAAACGUACGGAGUAAGAGACGUAAGUG"
  - rna:
      id: C
      sequence: "CACUUACGUCUCUUACUCCGUAC"
YAML

echo ""
echo "=== Running Boltz inference ==="
echo "Input: $TEST_YAML"
echo ""

boltz predict "$TEST_YAML" \
    --out_dir "$TEST_OUT" \
    --cache "$BOLTZ_CACHE" \
    --recycling_steps 3 \
    --diffusion_samples 1 \
    --use_msa_server

STATUS=$?
echo ""
echo "Exit status: $STATUS"

# ── Print output structure ────────────────────────────────────
echo ""
echo "=== Output files ==="
find "$TEST_OUT" -type f | sort

# ── Print confidence JSON: CRITICAL: tells us exact key names ─
echo ""
echo "=== Confidence JSON (check key names for parser) ==="
CONF_JSON=$(find "$TEST_OUT" -name "*confidence*" | head -1)
if [ -n "$CONF_JSON" ]; then
    echo "File: $CONF_JSON"
    cat "$CONF_JSON"
else
    echo "WARNING: No confidence JSON found, check that inference completed"
fi

echo ""
echo "Done: $(date)"
